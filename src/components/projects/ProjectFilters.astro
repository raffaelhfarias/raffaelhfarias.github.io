---
import {
  categoryLabel,
  categorySegment,
  projectCategories,
  type ProjectCategory,
} from "../../lib/project-taxonomy";

interface Props {
  locale: "pt" | "en";
  activeCategory?: ProjectCategory;
}

const { locale, activeCategory } = Astro.props;
const allLabel = locale === "pt" ? "Todos" : "All projects";
const indexPath = locale === "pt" ? "/pt/projetos/" : "/en/projects/";
---

<nav aria-label={locale === "pt" ? "Filtrar projetos" : "Filter projects"}>
  <ul>
    <li>
      <a href={indexPath} aria-current={!activeCategory ? "page" : undefined}>
        {allLabel}
      </a>
    </li>
    {
      projectCategories.map((category) => {
        const path = `${indexPath}${categorySegment(locale, category)}/`;
        return (
          <li>
            <a
              href={path}
              aria-current={activeCategory === category ? "page" : undefined}
            >
              {categoryLabel(locale, category)}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: block;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line);
    font: 0.75rem/1.2 var(--font-mono);
  }
  a[aria-current="page"] {
    border-color: var(--action);
    color: var(--action);
  }
</style>
