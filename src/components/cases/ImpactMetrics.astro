---
interface Metric {
  value: string;
  label: string;
  qualifier?: string;
}

interface Props {
  metrics: Metric[];
  locale: "pt" | "en";
}

const { metrics, locale } = Astro.props;
const heading = locale === "pt" ? "Evidência verificável" : "Verified evidence";
---

<section class="impact-metrics" aria-labelledby="case-metrics-title">
  <h2 id="case-metrics-title">{heading}</h2>
  <ul>
    {
      metrics.map((metric) => (
        <li data-metric>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
          {metric.qualifier && <small>{metric.qualifier}</small>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .impact-metrics {
    margin-top: var(--space-4);
  }
  h2 {
    margin: 0 0 var(--space-2);
    font-size: 1rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    margin: 0;
    padding: 1px;
    list-style: none;
    background: var(--line);
  }
  li {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-3);
    background: var(--surface);
  }
  strong {
    color: var(--action);
    font: 700 clamp(1.8rem, 4vw, 2.8rem) / 1 var(--font-display);
  }
  span {
    font-weight: 700;
  }
  small {
    color: var(--muted);
  }
</style>
