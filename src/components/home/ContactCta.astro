---
import type { ContactLink } from "./types";
export type { ContactLink } from "./types";
interface Props {
  eyebrow: string;
  heading: string;
  summary: string;
  links: ContactLink[];
}
const { eyebrow, heading, summary, links } = Astro.props;
---

<section class="section" data-section="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p><h2 id="contact-title">{heading}</h2><p>
      {summary}
    </p><ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<style>
  .section {
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  h2 {
    max-width: 14ch;
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    letter-spacing: -0.055em;
  }
  p:not(.eyebrow) {
    max-width: 42rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.65rem 1rem;
    border: 1px solid var(--ink);
    font: 700 0.75rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  a:hover {
    color: var(--action-contrast);
    background: var(--action);
    border-color: var(--action);
  }
</style>
