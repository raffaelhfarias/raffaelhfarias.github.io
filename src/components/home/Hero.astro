---
interface Props {
  eyebrow: string;
  heading: string;
  summary: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
  visual: {
    label: string;
    status: string;
    description: string;
    nodes: {
      input: { label: string; detail: string };
      trigger: { label: string; detail: string };
      context: { label: string; detail: string };
      transform: { label: string; detail: string };
      output: { label: string; detail: string };
      error: { label: string; detail: string };
    };
  };
}
const { eyebrow, heading, summary, primary, secondary, visual } = Astro.props;
---

<section class="hero" data-section="hero" aria-labelledby="home-title">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="home-title">
        {
          heading.split("\n").map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))
        }
      </h1>
      <p class="hero-summary">{summary}</p>
      <div class="hero-actions">
        <a class="button" href={primary.href}>{primary.label}</a><a
          class="button button-secondary"
          href={secondary.href}>{secondary.label}</a
        >
      </div>
    </div>
    <aside class="hero-visual" aria-label={visual.label}>
      <header class="visual-header">
        <span>{visual.label}</span>
        <span class="visual-status">
          <i aria-hidden="true"></i>
          {visual.status}
        </span>
      </header>
      <div class="topology" aria-hidden="true">
        <svg viewBox="0 0 360 300" role="presentation">
          <path class="flow-path" d="M82 143H96V40H112"></path>
          <path class="flow-path" d="M192 60V78M192 118V136M192 176V194"></path>
          <path class="flow-path flow-path-error" d="M272 214H282V254"></path>
          <circle class="flow-pulse pulse-one" cx="192" cy="69" r="3"></circle>
          <circle class="flow-pulse pulse-two" cx="192" cy="127" r="3"></circle>
          <circle class="flow-pulse pulse-three" cx="192" cy="185" r="3"
          ></circle>
          <g class="topology-node topology-input">
            <rect x="10" y="118" width="72" height="50"></rect>
            <text x="20" y="138">{visual.nodes.input.label}</text>
            <text x="20" y="154">{visual.nodes.input.detail}</text>
          </g>
          <g class="topology-node">
            <rect x="112" y="20" width="160" height="40"></rect>
            <text x="124" y="38">{visual.nodes.trigger.label}</text>
            <text x="124" y="51">{visual.nodes.trigger.detail}</text>
          </g>
          <g class="topology-node">
            <rect x="112" y="78" width="160" height="40"></rect>
            <text x="124" y="96">{visual.nodes.transform.label}</text>
            <text x="124" y="109">{visual.nodes.transform.detail}</text>
          </g>
          <g class="topology-node">
            <rect x="112" y="136" width="160" height="40"></rect>
            <text x="124" y="154">{visual.nodes.context.label}</text>
            <text x="124" y="167">{visual.nodes.context.detail}</text>
          </g>
          <g class="topology-node">
            <rect x="112" y="194" width="160" height="40"></rect>
            <text x="124" y="212">{visual.nodes.output.label}</text>
            <text x="124" y="225">{visual.nodes.output.detail}</text>
          </g>
          <g class="topology-node topology-error">
            <rect x="282" y="234" width="68" height="40"></rect>
            <text x="290" y="252">{visual.nodes.error.label}</text>
            <text x="290" y="265">{visual.nodes.error.detail}</text>
          </g>
        </svg>
      </div>
      <p class="visual-description">{visual.description}</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
    gap: clamp(var(--space-2), 4vw, var(--space-4));
    align-items: center;
  }
  h1 {
    max-width: 100%;
    margin: var(--space-1) 0 var(--space-2);
    font-size: clamp(2.5rem, 4.2vw, 4rem);
    letter-spacing: -0.055em;
  }
  .hero-summary {
    max-width: 42rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    color: var(--action-contrast);
    background: var(--action);
    font: 700 0.8rem/1 var(--font-mono);
    letter-spacing: 0.03em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .button-secondary {
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
  }
  .hero-visual {
    display: grid;
    min-height: 22rem;
    align-content: space-between;
    padding: var(--space-3);
    overflow: hidden;
    color: var(--paper);
    background: var(--ink);
    border: 0;
  }
  .visual-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font: 700 0.68rem/1.2 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .visual-header {
    color: var(--line);
  }
  .visual-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--paper);
  }
  .visual-status i {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--action);
    animation: status-pulse 1.8s ease-in-out infinite;
  }
  .topology {
    margin: var(--space-2) -0.5rem;
  }
  .topology svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .flow-path {
    fill: none;
    stroke: var(--action);
    stroke-width: 1;
    stroke-dasharray: 5 6;
    animation: flow-dash 1.8s linear infinite;
  }
  .flow-path-error {
    stroke: var(--line);
    animation-delay: 0.8s;
  }
  .flow-pulse {
    fill: var(--action);
    animation: flow-pulse 1.8s ease-in-out infinite;
  }
  .pulse-two {
    animation-delay: 0.35s;
  }
  .pulse-three {
    animation-delay: 0.7s;
  }
  .topology-node rect {
    fill: var(--paper);
    stroke: var(--line);
    stroke-width: 1;
  }
  .topology-node text {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.04em;
  }
  .topology-node text + text {
    fill: var(--muted);
    font-size: 7px;
    letter-spacing: 0;
  }
  .topology-input rect {
    fill: var(--action);
    stroke: var(--action);
  }
  .topology-input text,
  .topology-input text + text {
    fill: var(--action-contrast);
  }
  .topology-error rect {
    fill: transparent;
    stroke: var(--line);
    stroke-dasharray: 3 3;
  }
  .visual-description {
    max-width: 25rem;
    margin: 0 0 var(--space-2);
    color: var(--line);
    font-size: 0.78rem;
    line-height: 1.4;
  }
  @keyframes flow-dash {
    to {
      stroke-dashoffset: -22;
    }
  }
  @keyframes flow-pulse {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.75);
      transform-box: fill-box;
      transform-origin: center;
    }
    50% {
      opacity: 1;
      transform: scale(1.4);
    }
  }
  @keyframes status-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  @media (max-width: 48rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    h1 {
      max-width: 16ch;
    }
    .hero-visual {
      min-height: 18rem;
    }
  }
</style>
