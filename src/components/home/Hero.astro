---
interface Props {
  eyebrow: string;
  heading: string;
  summary: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
  visual: {
    label: string;
    status: string;
    steps: string[];
    footer: string;
  };
}
const { eyebrow, heading, summary, primary, secondary, visual } = Astro.props;
---

<section class="hero" data-section="hero" aria-labelledby="home-title">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="home-title">
        {
          heading.split("\n").map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))
        }
      </h1>
      <p class="hero-summary">{summary}</p>
      <div class="hero-actions">
        <a class="button" href={primary.href}>{primary.label}</a><a
          class="button button-secondary"
          href={secondary.href}>{secondary.label}</a
        >
      </div>
    </div>
    <aside class="hero-visual" aria-label={visual.label}>
      <header class="visual-header">
        <span>{visual.label}</span>
        <span class="visual-status">
          <i aria-hidden="true"></i>
          {visual.status}
        </span>
      </header>
      <ol class="workflow">
        {
          visual.steps.map((step, index) => (
            <li>
              <span class="workflow-node" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
      <footer class="visual-footer">
        <span>KESTRA / RUN</span>
        <span>{visual.footer}</span>
      </footer>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
    gap: clamp(var(--space-2), 4vw, var(--space-4));
    align-items: center;
  }
  h1 {
    max-width: 100%;
    margin: var(--space-1) 0 var(--space-2);
    font-size: clamp(2.5rem, 4.2vw, 4rem);
    letter-spacing: -0.055em;
  }
  .hero-summary {
    max-width: 42rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    color: var(--action-contrast);
    background: var(--action);
    font: 700 0.8rem/1 var(--font-mono);
    letter-spacing: 0.03em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .button-secondary {
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
  }
  .hero-visual {
    display: grid;
    min-height: 22rem;
    align-content: space-between;
    padding: var(--space-3);
    overflow: hidden;
    color: var(--paper);
    background: var(--ink);
    border-block: 3px solid var(--action);
  }
  .visual-header,
  .visual-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font: 700 0.68rem/1.2 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .visual-header {
    color: var(--line);
  }
  .visual-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--paper);
  }
  .visual-status i {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--action);
    animation: status-pulse 1.8s ease-in-out infinite;
  }
  .workflow {
    position: relative;
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0;
    padding: 0;
    list-style: none;
  }
  .workflow::before {
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1rem;
    width: 1px;
    background: var(--action);
    content: "";
  }
  .workflow li {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--paper);
    font-size: 1.05rem;
  }
  .workflow-node {
    display: grid;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    color: var(--paper);
    background: var(--ink);
    border: 1px solid var(--action);
    font: 700 0.68rem/1 var(--font-mono);
  }
  .workflow li:nth-child(2) .workflow-node {
    animation-delay: 0.35s;
  }
  .workflow li:nth-child(3) .workflow-node {
    animation-delay: 0.7s;
  }
  .visual-footer {
    padding-top: var(--space-2);
    color: var(--line);
    border-top: 1px solid var(--muted);
  }
  @keyframes status-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes node-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
    50% {
      box-shadow: 0 0 0 0.25rem rgb(22 77 204 / 18%);
    }
  }
  @media (max-width: 48rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    h1 {
      max-width: 16ch;
    }
    .hero-visual {
      min-height: 18rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .workflow-node {
      animation: node-pulse 1.8s ease-in-out infinite;
    }
  }
</style>
