---
interface Props {
  eyebrow: string;
  heading: string;
  summary: string;
  primary: { label: string; href: string };
  secondary: { label: string; href: string };
  availability: string;
  meta: string[];
}
const { eyebrow, heading, summary, primary, secondary, availability, meta } =
  Astro.props;
---

<section class="hero" data-section="hero" aria-labelledby="home-title">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="home-title">{heading}</h1>
      <p class="hero-summary">{summary}</p>
      <div class="hero-actions">
        <a class="button" href={primary.href}>{primary.label}</a><a
          class="button button-secondary"
          href={secondary.href}>{secondary.label}</a
        >
      </div>
    </div>
    <aside aria-label={availability}>
      <strong>{availability}</strong><ul>
        {meta.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(var(--space-4), 9vw, 8rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 20rem);
    gap: clamp(var(--space-3), 6vw, var(--space-5));
    align-items: end;
  }
  h1 {
    max-width: 14ch;
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    letter-spacing: -0.055em;
  }
  .hero-summary {
    max-width: 42rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    color: var(--action-contrast);
    background: var(--action);
    font: 700 0.8rem/1 var(--font-mono);
    letter-spacing: 0.03em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .button-secondary {
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
  }
  aside {
    padding: var(--space-3);
    border-top: 3px solid var(--action);
    background: var(--surface);
  }
  aside strong {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  ul {
    margin: var(--space-2) 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  @media (max-width: 48rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    h1 {
      max-width: 16ch;
    }
  }
</style>
