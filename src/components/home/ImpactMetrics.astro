---
import type { Metric } from "./types";
export type { Metric } from "./types";
interface Props {
  metrics: Metric[];
  eyebrow: string;
  heading: string;
  emptyMessage: string;
}
const { metrics, eyebrow, heading, emptyMessage } = Astro.props;
---

<section
  class="section"
  data-section="impact-metrics"
  aria-labelledby="impact-title"
>
  <div class="container">
    <p class="eyebrow">{eyebrow}</p><h2 id="impact-title">{heading}</h2>{
      metrics.length ? (
        <ul class="metrics">
          {metrics.map((metric) => (
            <li>
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
              {metric.qualifier && <small>{metric.qualifier}</small>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="notice">{emptyMessage}</p>
      )
    }
  </div>
</section>

<style>
  .section {
    padding-block: 3rem;
    border-block: 1px solid var(--line);
    background: var(--surface);
  }
  h2 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: -0.04em;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .metrics li {
    display: grid;
    gap: 0.25rem;
    padding: var(--space-3);
    border-left: 1px solid var(--line);
  }
  .metrics strong {
    font: 700 clamp(1.8rem, 4vw, 3rem)/1 var(--font-display);
  }
  small,
  .notice {
    color: var(--muted);
  }
  .notice {
    max-width: 42rem;
    margin: 0;
  }
  @media (max-width: 42rem) {
    .metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
