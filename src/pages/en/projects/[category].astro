---
import ProjectCard from "../../../components/projects/ProjectCard.astro";
import ProjectFilters from "../../../components/projects/ProjectFilters.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  categoryFromSegment,
  categorySegments,
  getPublishedProjects,
  groupByCategory,
  projectCategories,
  type ProjectCategory,
} from "../../../lib/projects";

export function getStaticPaths() {
  return projectCategories.map((category) => ({
    params: { category: categorySegments.en[category] },
    props: { category },
  }));
}

const { category } = Astro.props as { category: ProjectCategory };
const resolvedCategory = categoryFromSegment("en", Astro.params.category ?? "");
if (resolvedCategory !== category)
  throw new Error("Invalid project category path.");
const projects = groupByCategory(await getPublishedProjects("en"))[category];
const labels: Record<ProjectCategory, string> = {
  "data-engineering": "Data engineering",
  automation: "Automation",
  analytics: "Analytics",
};
const label = labels[category];
const canonicalPath = `/en/projects/${categorySegments.en[category]}/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${label} projects | Raffael Henrique`,
  url: `https://raffaelhfarias.github.io${canonicalPath}`,
};
---

<BaseLayout
  locale="en"
  title={`${label} projects | Raffael Henrique`}
  description={`Published ${label.toLowerCase()} case studies.`}
  canonicalPath={canonicalPath}
  alternatePath={`/pt/projetos/${categorySegments.pt[category]}/`}
  image="/images/social-preview.png"
  jsonLd={jsonLd}
>
  <section class="container projects" aria-labelledby="projects-title">
    <p class="eyebrow">Selected work</p>
    <h1 id="projects-title">{label}</h1>
    <ProjectFilters locale="en" activeCategory={category} />
    {
      projects.length ? (
        <div class="grid">
          {projects.map((entry) => (
            <ProjectCard
              entry={entry}
              href={`/en/projects/${entry.data.slug}/`}
              locale="en"
            />
          ))}
        </div>
      ) : (
        <p class="notice">No published case studies match this category yet.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .projects {
    padding-block: clamp(var(--space-4), 9vw, 7rem);
  }
  h1 {
    margin: var(--space-1) 0 var(--space-3);
    font-size: clamp(3rem, 8vw, 6.5rem);
    letter-spacing: -0.06em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-1);
    margin-top: var(--space-3);
  }
  .notice {
    color: var(--muted);
    margin-top: var(--space-3);
  }
</style>
