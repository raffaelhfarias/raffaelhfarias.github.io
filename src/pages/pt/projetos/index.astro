---
import ProjectCard from "../../../components/projects/ProjectCard.astro";
import ProjectFilters from "../../../components/projects/ProjectFilters.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedProjects } from "../../../lib/projects";

const projects = await getPublishedProjects("pt");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Projetos | Raffael Henrique",
  url: "https://raffaelhfarias.github.io/pt/projetos/",
};
---

<BaseLayout
  locale="pt"
  title="Projetos | Raffael Henrique"
  description="Cases publicados de engenharia de dados, automaÃ§Ã£o e anÃ¡lise."
  canonicalPath="/pt/projetos/"
  alternatePath="/en/projects/"
  image="/images/social-preview.png"
  jsonLd={jsonLd}
>
  <section class="container projects" aria-labelledby="projects-title">
    <p class="eyebrow">Trabalho selecionado</p>
    <h1 id="projects-title">Projetos</h1>
    <p class="lead">
      Cases publicados com a evidÃªncia que pode ser compartilhada.
    </p>
    <ProjectFilters locale="pt" />
    {
      projects.length ? (
        <div class="grid">
          {projects.map((entry) => (
            <ProjectCard
              entry={entry}
              href={`/pt/projetos/${entry.data.slug}/`}
              locale="pt"
            />
          ))}
        </div>
      ) : (
        <p class="notice">Ainda nÃ£o hÃ¡ cases de projeto publicados.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .projects {
    padding-block: clamp(var(--space-4), 9vw, 7rem);
  }
  h1 {
    margin: var(--space-1) 0;
    font-size: clamp(3rem, 8vw, 6.5rem);
    letter-spacing: -0.06em;
  }
  .lead,
  .notice {
    max-width: 42rem;
    color: var(--muted);
  }
  nav {
    margin-top: var(--space-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-1);
    margin-top: var(--space-3);
  }
</style>
