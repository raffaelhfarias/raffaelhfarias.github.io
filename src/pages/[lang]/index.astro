---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isLocale, type Locale } from "../../i18n/locales";

export function getStaticPaths() {
  return [{ params: { lang: "pt" } }, { params: { lang: "en" } }];
}

const candidate = Astro.params.lang ?? "";
if (!isLocale(candidate)) throw new Error(`Unsupported locale: ${candidate}`);
const locale: Locale = candidate;
const copy =
  locale === "pt"
    ? {
        title: "Engenheiro de Dados e Automação — Raffael Henrique",
        description: "Pipelines e automações confiáveis.",
        heading: "Sistemas que transformam complexidade operacional em fluxo.",
        label: "Engenharia editorial para operações reais",
        introduction:
          "Projeto e entrego dados e automações confiáveis para que equipes operem com mais clareza, ritmo e segurança.",
      }
    : {
        title: "Data & Automation Engineer — Raffael Henrique",
        description: "Reliable data pipelines and automation.",
        heading: "Systems that turn operational complexity into flow.",
        label: "Editorial engineering for real operations",
        introduction:
          "I design and deliver reliable data and automation systems that help teams operate with greater clarity, pace, and confidence.",
      };

const canonicalPath = `/${locale}/`;
const alternatePath = locale === "pt" ? "/en/" : "/pt/";
const profileUrl = "https://raffaelhfarias.github.io";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: "Raffael Henrique",
      jobTitle:
        locale === "pt"
          ? "Engenheiro de Dados e AutomaÃ§Ã£o"
          : "Data & Automation Engineer",
      url: `${profileUrl}${canonicalPath}`,
    },
    {
      "@type": "WebSite",
      name: "Raffael Henrique",
      url: `${profileUrl}${canonicalPath}`,
      inLanguage: locale === "pt" ? "pt-BR" : "en",
    },
  ],
};
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  image="/images/social-preview.png"
  jsonLd={jsonLd}
>
  <section class="hero container" aria-labelledby="page-title">
    <p class="eyebrow">{copy.label}</p>
    <h1 id="page-title">{copy.heading}</h1>
    <p>{copy.introduction}</p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-content: center;
    min-height: clamp(28rem, 65vh, 48rem);
    max-width: 72rem;
    padding-block: var(--space-5);
  }
  h1 {
    max-width: 16ch;
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    letter-spacing: -0.055em;
  }
  p:last-child {
    max-width: 42rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
  }
</style>
