---
import EngineeringStack from "../../components/home/EngineeringStack.astro";
import FeaturedCases from "../../components/home/FeaturedCases.astro";
import Hero from "../../components/home/Hero.astro";
import { engineeringToolGroups } from "../../components/home/engineering-stack";
import type { FeaturedProject } from "../../components/home/types";
import type { JsonLd } from "../../components/seo/serialize-json-ld";
import { isLocale, type Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getFeaturedProjects } from "../../lib/projects";

export function getStaticPaths() {
  return [{ params: { lang: "pt" } }, { params: { lang: "en" } }];
}
const candidate = Astro.params.lang ?? "";
if (!isLocale(candidate)) throw new Error(`Unsupported locale: ${candidate}`);
const locale: Locale = candidate;
const isPortuguese = locale === "pt";
const copy = isPortuguese
  ? {
      title: "Engenheiro de Dados e Automação — Raffael Henrique",
      description: "Pipelines e automações confiáveis.",
      hero: {
        eyebrow: "Engenheiro de Dados e Automação",
        heading:
          "Sistemas que transformam\ncomplexidade operacional\nem fluxo.",
        summary:
          "Projeto e entrego dados e automações confiáveis para que equipes operem com mais clareza, ritmo e segurança.",
        primary: {
          label: "Explorar cases",
          href: localizedPath(locale, "projects"),
        },
        secondary: {
          label: "Solicitar currículo",
          href: "mailto:raffaelhfarias@gmail.com?subject=Curr%C3%ADculo%20para%20oportunidade",
        },
        visual: {
          label: "Kestra / topologia do fluxo",
          status: "Executando",
          description:
            "O analista informa período e empresas pelo WhatsApp; o fluxo extrai e responde no mesmo canal.",
          nodes: {
            input: { label: "WHATSAPP", detail: "analista" },
            trigger: { label: "KESTRA", detail: "receber_pedido" },
            context: { label: "CONTEXTO", detail: "período + empresas" },
            transform: { label: "PYTHON", detail: "extrair_dados" },
            output: { label: "WHATSAPP", detail: "responder_resultado" },
            error: { label: "FALHA", detail: "notificar_erro" },
          },
        },
      },
      stack: {
        eyebrow: "Stack de engenharia",
        heading: "Ferramentas que sustentam a entrega.",
        intro: "Dados, automação e infraestrutura conectados ao problema real.",
      },
      cases: {
        eyebrow: "Cases selecionados",
        heading: "Engenharia em produção",
        emptyMessage:
          "Os cases selecionados serão publicados com responsabilidade, contexto técnico e evidências verificáveis.",
        stackLabel: "Tecnologias utilizadas",
      },
    }
  : {
      title: "Data & Automation Engineer — Raffael Henrique",
      description: "Reliable data pipelines and automation.",
      hero: {
        eyebrow: "Data & Automation Engineer",
        heading: "Systems that turn\noperational complexity\ninto flow.",
        summary:
          "I design and deliver reliable data and automation systems that help teams operate with greater clarity, pace, and confidence.",
        primary: {
          label: "Explore case studies",
          href: localizedPath(locale, "projects"),
        },
        secondary: {
          label: "Request tailored résumé",
          href: "mailto:raffaelhfarias@gmail.com?subject=Role-specific%20r%C3%A9sum%C3%A9",
        },
        visual: {
          label: "Kestra / workflow topology",
          status: "Running",
          description:
            "The analyst sends the period and companies through WhatsApp; the flow extracts and replies in the same channel.",
          nodes: {
            input: { label: "WHATSAPP", detail: "analyst" },
            trigger: { label: "KESTRA", detail: "receive_request" },
            context: { label: "CONTEXT", detail: "period + companies" },
            transform: { label: "PYTHON", detail: "extract_data" },
            output: { label: "WHATSAPP", detail: "reply_result" },
            error: { label: "ERROR", detail: "notify_error" },
          },
        },
      },
      stack: {
        eyebrow: "Engineering stack",
        heading: "Tools that sustain delivery.",
        intro:
          "Data, automation, and infrastructure connected to the real problem.",
      },
      cases: {
        eyebrow: "Selected case studies",
        heading: "Engineering in production",
        emptyMessage:
          "Selected case studies will be published with responsibility, technical context, and verifiable evidence.",
        stackLabel: "Technologies used",
      },
    };
const featuredEntries = await getFeaturedProjects(locale);
const featuredProjects: FeaturedProject[] = featuredEntries.map((entry) => {
  const metric = entry.data.metrics[0];
  if (!metric)
    throw new Error(`Featured project ${entry.id} is missing a metric.`);
  return {
    title: entry.data.title,
    summary: entry.data.summary,
    href: localizedPath(locale, `projects/${entry.data.slug}`),
    stack: entry.data.stack,
    metric,
  };
});
const canonicalPath = `/${locale}/`;
const alternatePath = isPortuguese ? "/en/" : "/pt/";
const profileUrl = "https://raffaelhfarias.github.io";
const jsonLd: JsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: "Raffael Henrique",
      jobTitle: isPortuguese
        ? "Engenheiro de Dados e Automação"
        : "Data & Automation Engineer",
      url: `${profileUrl}${canonicalPath}`,
    },
    {
      "@type": "WebSite",
      name: "Raffael Henrique",
      url: `${profileUrl}${canonicalPath}`,
      inLanguage: isPortuguese ? "pt-BR" : "en",
    },
  ],
};
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  image="/images/social-preview.png"
  jsonLd={jsonLd}
>
  <Hero {...copy.hero} />
  <EngineeringStack groups={engineeringToolGroups[locale]} {...copy.stack} />
  <FeaturedCases projects={featuredProjects} {...copy.cases} />
</BaseLayout>
